# Copy to .env (never commit .env) and choose strong passwords.
POSTGRES_PASSWORD=change-me-database-password
RISKMESH_ADMIN_USER=admin
RISKMESH_ADMIN_PASSWORD=change-me-admin-password
# local | oidc | local+oidc
RISKMESH_AUTH_MODE=local
# web front ends allowed to call the API (comma-separated)
RISKMESH_CORS_ORIGINS=http://localhost:8080
RISKMESH_PORT=8000
RISKMESH_WORKERS=2
# single sign-on client secret (configure the rest in config/riskmesh.toml)
RISKMESH_OIDC_CLIENT_SECRET=
